{"kind":"table","sheet":"All Products","address":"A1:D23","rows":23,"cols":4,"values":[["Product","L1 Feature","L2 Feature","Short Spec"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","PERFORMANCE","AI PC Category","Copilot+ PC (Lunar Lake)\nAI PC (Arrow Lake)"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","MULTIMEDIA","Audio","Arrow Lake: High Definition (HD) Audio\nLunar Lake: SoundWire\nStereo speakers, 2W x2, Dolby Atmos\nDual-microphone array, 360° far-field, Dolby Voice"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","MOBILITY","Battery","57Wh battery, Rapid Charge\nUp to 17.11 hr"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","MULTIMEDIA","Camera","FHD 1080p + IR discrete, with privacy shutter, temporal noise reduction\nUHD 8.0MP + IR discrete, with privacy shutter, Computer Vision, temporal noise reduction"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","DESIGN","Case Material","Carbon fiber (top), magnesium or aluminium (bottom)"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","DESIGN","Color","Black, paint\nBlack, paint, FIFA Edition\nBlack, weave"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","DESIGN","Dimensions (WxDxH)","Starting at:\n312.80 x 214.75 x 8.08/14.37 (front/rear), 16.95 (maximum) mm;\n12.31 x 8.45 x 0.32/0.56 (front/rear), 0.67 (maximum) inches"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","SPECIAL FEATURES","Docking","Docking solutions supported via Thunderbolt / USB-C"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","PERFORMANCE","Graphics","Intel Graphics (integrated)\nIntel Arc 130T GPU (integrated)\nIntel Arc 140T GPU (integrated)\nIntel Arc Graphics 130V (integrated)\nIntel Arc Graphics 140V (integrated)"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","CERTIFICATIONS","Green Certifications","ENERGY STAR 9.0\nEPEAT Gold Registered\nErP Lot 6/26\nRoHS compliant\nTCO Certified, generation 10"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","DESIGN","Material","Recycled carbon fiber contained in plastic frame on top cover\n90% recycled magnesium on keyboard frame\n90% recycled magnesium or 45% hydro aluminum on bottom cover\n85% PCC recycled plastic used in keycaps of backlit keyboard\n90% PCC recycled plastic used in speaker enclosure\n90% PCC recycled plastic used in the 57Wh battery pack enclosure\n90% PCC recycled plastic used in 65W adapters\n35% PCC recycled plastic used in cable / antenna holders\n25% PCC recycled plastic used in hall sensor magnet\nPlastic free packaging with FSC certified paper"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","CONNECTIVITY","NFC","Near Field Communication*"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","PERFORMANCE","NPU","Integrated Intel AI Boost, up to 48 TOPS"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","CONNECTIVITY","Ports","1x USB-A (USB 5Gbps / USB 3.2 Gen 1)\n1x USB-A (USB 5Gbps / USB 3.2 Gen 1), Always On\n2x USB-C (Thunderbolt 4 / USB4 40Gbps), with USB PD 15-65W and DisplayPort 2.1\n1x HDMI 2.1, up to 4K/60Hz\n1x Headphone / microphone combo jack (3.5mm)\n1x Nano-SIM card slot (WWAN support models)*"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","MOBILITY","Power Adapter","65W USB-C adapter, PD 3.0*\n65W USB-C nano GaN adapter, PD 3.0*\n65W USB-C slim adapter, PD 3.0*\n65W USB-C slim GaN adapter, PD 3.0*"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","PERFORMANCE","Processor","Intel U or H Series Core Ultra 5 / 7 Processor (Series 2) - Arrow Lake\nIntel V Series Core Ultra 5 / 7 Processor (Series 2) - Lunar Lake"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","DESIGN","Screen-to-Body Ratio","89.2%"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","SECURITY & PRIVACY","Security","ThinkShield\nDiscrete TPM 2.0\nKensington Nano Security Slot\nTouch style MOC fingerprint reader\nComputer Vision-based Human Presence Detection*\nCamera privacy shutter\nUltrasonic Human Presence Detection*\nIR camera for Windows Hello (facial recognition)\nPrivacy Guard with Privacy Alert*"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","MANAGEABILITY","System Management","Intel vPro Enterprise*"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","SPECIAL FEATURES","Touchpad","TrackPoint and glass surface Haptic Touchpad\n70.5 x 120 mm (2.78 x 4.72 inches)\nTrackPoint and glass surface Trackpad\n56.2 x 120 mm (2.21 x 4.72 inches)"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","DESIGN","Weight","Starting at 1006 g (2.22 lbs)\nStarting at 986 g (2.17 lbs)"],["ThinkPad_X1_Carbon_Gen_13_Aura_Edition","CONNECTIVITY","WWAN","WWAN upgradable to 5G Sub-6 GHz with embedded eSIM"]]}
