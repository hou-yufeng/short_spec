{"kind":"table","sheet":"All Products","address":"A1:D21","rows":21,"cols":4,"values":[["Product","L1 Feature","L2 Feature","Short Spec"],["ThinkBook_16p_G6_IAX","PERFORMANCE","AI PC Category","AI PC"],["ThinkBook_16p_G6_IAX","MULTIMEDIA","Audio","High Definition (HD) Audio\nStereo speakers, 2W x2 woofers and 2W x2 tweeters, Dolby Atmos, sound by harman/kardon, Smart Amplifier (AMP)\nDual-microphone array with smart noise-cancelling"],["ThinkBook_16p_G6_IAX","MOBILITY","Battery","85Wh battery, Rapid Charge Pro\nUp to 5.35 hr"],["ThinkBook_16p_G6_IAX","MULTIMEDIA","Camera","FHD 1080p + IR hybrid, with privacy shutter"],["ThinkBook_16p_G6_IAX","DESIGN","Case Material","Aluminium (top), aluminium (bottom)"],["ThinkBook_16p_G6_IAX","PERFORMANCE","Chipset","Intel HM870 chipset"],["ThinkBook_16p_G6_IAX","DESIGN","Color","Luna grey, dual-tone design"],["ThinkBook_16p_G6_IAX","DESIGN","Dimensions (WxDxH)","354.6 x 256.2 x 17.9 mm (13.96 x 10.09 x 0.70 inches)"],["ThinkBook_16p_G6_IAX","SPECIAL FEATURES","Docking","Docking solutions supported via Thunderbolt / USB-C"],["ThinkBook_16p_G6_IAX","PERFORMANCE","Graphics","NVIDIA GeForce RTX 5060 Laptop GPU 8GB GDDR7 (discrete)\nNVIDIA GeForce RTX 5070 Laptop GPU 12GB GDDR7 (discrete)\nNVIDIA GeForce RTX 5070 Laptop GPU 8GB GDDR7 (discrete)"],["ThinkBook_16p_G6_IAX","CERTIFICATIONS","Green Certifications","ENERGY STAR 9.0\nEPEAT 1.0 Gold Registered\nErP Lot 6/26\nRoHS compliant\nTCO Certified, generation 10"],["ThinkBook_16p_G6_IAX","DESIGN","Material","50% recycled aluminum alloy on bottom cover\n25% PCC recycled plastic used in the battery pack enclosure\n50% PCC recycled plastic used in key caps\n30% PCC recycled plastic used in speaker enclosure\n100% use of paper in cushion, screen sheet, bag, carton handle, and sealing label\nFSC certified content in carton box and accessory box"],["ThinkBook_16p_G6_IAX","PERFORMANCE","NPU","M.2 2280 discrete NPU card, up to 32 TOPS*\nIntegrated Intel AI Boost, up to 13 TOPS"],["ThinkBook_16p_G6_IAX","CONNECTIVITY","Ports","2x USB-A (USB 5Gbps / USB 3.2 Gen 1)\n1x USB-A (USB 10Gbps / USB 3.2 Gen 2), Always On\n2x Thunderbolt 4, with USB PD 95-100W and DisplayPort 2.1\n1x HDMI 2.1, up to 8K/60Hz\n1x Headphone / microphone combo jack (3.5mm)\n1x SD card reader\n1x Slim tip power connector\n1x Magic Bay (pogo pin connector)"],["ThinkBook_16p_G6_IAX","MOBILITY","Power Adapter","300W slim tip adapter*"],["ThinkBook_16p_G6_IAX","PERFORMANCE","Processor","Intel HX Series Core Ultra 5 / 7 / 9 Processor (Series 2)"],["ThinkBook_16p_G6_IAX","DESIGN","Screen-to-Body Ratio","93%"],["ThinkBook_16p_G6_IAX","SECURITY & PRIVACY","Security","Firmware TPM 2.0\nKensington Nano Security Slot\nTouch style MOC fingerprint reader\nCamera privacy shutter\nIR camera for Windows Hello (facial recognition)"],["ThinkBook_16p_G6_IAX","SPECIAL FEATURES","Touchpad","glass surface Haptic Touchpad\n80 x 135 mm (3.15 x 5.31 inches)\nglass surface touchpad\n80 x 135 mm (3.15 x 5.31 inches)"],["ThinkBook_16p_G6_IAX","DESIGN","Weight","Starting at 2.1 kg (4.63 lbs)"]]}
